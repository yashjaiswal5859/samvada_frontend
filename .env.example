# =============================================================================
# Samvada Voice AI — Isolated Frontend Environment Configuration
# Deploy anywhere (AWS S3 + CloudFront, Cloudflare Pages, Vercel, Netlify)
# =============================================================================

# Production Headless API Gateway URL (e.g. https://api.samvada.ai or http://localhost:8080)
# Leave blank for local development using Vite dev proxy
VITE_API_BASE_URL=

# Production Real-time WebSocket Gateway URL (e.g. wss://api.samvada.ai or ws://localhost:8084)
VITE_WS_BASE_URL=
